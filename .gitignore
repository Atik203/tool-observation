# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/
*.prof
.mypy_cache/
.tox/
.nox/

# ---------------------------------------------------------------------------
# Web frontend (Next.js)
# ---------------------------------------------------------------------------
web/node_modules/
web/.next/
web/out/
web/.vercel/
web/*.tsbuildinfo
web/pnpm-debug.log*

# ---------------------------------------------------------------------------
# Data - only manifests and .gitkeep files are trackable
# ---------------------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep
data/upstream/*
!data/upstream/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/frozen/*
!data/frozen/.gitkeep
data/runs/*
!data/runs/.gitkeep

# Manifests are small, non-PII, and must be committed
data/manifests/*
!data/manifests/.gitkeep
!data/manifests/*.json
!data/manifests/*.jsonl
!data/manifests/*.yaml
!data/manifests/*.yml
!data/manifests/*.csv
!data/manifests/*.md

/runs/
/run/
/outputs/
/logs/
*.log
*.jsonl.gz
*.parquet
*.arrow
*.feather
*.pkl
*.pickle
*.npz
*.npy

# ---------------------------------------------------------------------------
# Model weights, adapters, caches
# ---------------------------------------------------------------------------
models/
checkpoints/
weights/
adapters/
hf_cache/
.cache/huggingface/
*.safetensors
*.safetensors.index.json
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.awq
*.onnx
*.h5
*.msgpack
*.model

# ---------------------------------------------------------------------------
# Secrets and credentials
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets.yaml
secrets.yml
credentials.json
credentials.yaml
token.txt
tokens.txt
*.token
.ssh/
.wslconfig

# ---------------------------------------------------------------------------
# Artifacts — keep READMEs and .gitkeep only
# ---------------------------------------------------------------------------
artifacts/*
!artifacts/README.md
!artifacts/audit/
!artifacts/analysis/
!artifacts/env/
!artifacts/cost/
!artifacts/paper/
artifacts/audit/*
!artifacts/audit/.gitkeep
artifacts/analysis/*
!artifacts/analysis/.gitkeep
artifacts/env/*
!artifacts/env/.gitkeep
artifacts/cost/*
!artifacts/cost/.gitkeep
artifacts/paper/*
!artifacts/paper/.gitkeep

# ---------------------------------------------------------------------------
# Paper build and release artifacts
# ---------------------------------------------------------------------------
paper/build/
paper/out/*
!paper/out/*.pdf
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
release/CTO-800-*/
release/*.zip
release/*.tar.gz

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Local scratch
# ---------------------------------------------------------------------------
tmp/
temp/
scratch/
*.bak
*.orig
*.rej

# Never ignore the placeholder files that keep directories in git
!.gitkeep
